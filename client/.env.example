# ==============================================================================
# ONECOOLIE Frontend Environment Template (Phase 7 Production Readiness)
# Public frontend variables ONLY (prefixed with VITE_).
# Never place database keys, backend secrets, or payment private keys in this file!
# ==============================================================================

# Backend API endpoint (e.g., https://api.onecoolie.in/api or https://onecoolie.onrender.com/api)
VITE_API_URL=https://onecoolie.onrender.com/api

# Real-time WebSocket server endpoint (e.g., https://api.onecoolie.in or https://onecoolie.onrender.com)
VITE_SOCKET_URL=https://onecoolie.onrender.com

# Public Razorpay Key ID (Key ID only - NEVER supply Key Secret here!)
# In production, must begin with 'rzp_live_'
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
